# ---- Message broker ----
# azure | kubemq — defaults to azure if unset.
MESSAGE_PROVIDER=azure

# ---- Azure Service Bus ----
# Provide EITHER a connection string OR a fully-qualified namespace + managed identity.
# SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://...;SharedAccessKeyName=...;SharedAccessKey=...
SERVICE_BUS_NAMESPACE=mybus.servicebus.windows.net
SERVICE_BUS_QUEUE=my-queue

# ---- KubeMQ ----
# Host:port of the KubeMQ broker (e.g. localhost:50000).
KUBEMQ_ADDRESS=
# Event channel to subscribe to. The producer should send UTF-8 JSON
# matching the Service Bus v1 payload contract.
KUBEMQ_CHANNEL=
# Optional - auth token (omit for unsecured local brokers).
# KUBEMQ_TOKEN=
# Optional - enable TLS with a client certificate and key.
# KUBEMQ_TLS=false
# KUBEMQ_TLS_CERT_PATH=
# KUBEMQ_TLS_KEY_PATH=
# Optional - client identifier for broker logs/metrics.
# KUBEMQ_CLIENT_ID=
# Optional - delivery group. Subscribers sharing the same group + channel
# load-balance messages; different groups all receive every event.
# KUBEMQ_GROUP=

# ---- Reports mapping (JSON file for now, DB later) ----
REPORTS_CONFIG_PATH=./config/reports.json

# ---- Unit factories (allowed unit factory numbers) ----
UNIT_FACTORIES_CONFIG_PATH=./config/unit-factories.json

# ---- Home Assistant / MQTT ----
# mqtts://user:password@host:port  OR  mqtt://user:password@host:port
MQTT_URL=mqtts://ha:secret@localhost:8883
# Device name, area, ID, and factory mapping come from unit-factories.json.
# Optional - defaults to homeassistant
HA_DISCOVERY_PREFIX=homeassistant
# Optional - republish all discovery configs every N seconds.
# Default 3600 (1 hour). Set to 0 to disable periodic refresh.
# HA_DISCOVERY_REFRESH_SECONDS=3600
